# Copy to .env.local for local development. Leave these unset to use demo mode
# (data stays in this browser only). Never commit a real .env file.
#
# VITE_SUPABASE_ANON_KEY is the public publishable key (sb_publishable_...).
# Older projects may show a long anon JWT instead. Both work with supabase-js 2.117+.
# Never put the secret key (sb_secret_...) or the service-role key in a VITE_ variable.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key

# Optional. Defaults to profile-pictures when unset.
VITE_SUPABASE_BUCKET=profile-pictures
